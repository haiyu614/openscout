{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true
  },
  "include": ["packages/*/src/**/*.ts"],
  "exclude": [
    "node_modules",
    "**/dist/**",
    "**/tests/**",
    "**/*.test.ts",
    "vitest.config.ts"
  ],
  "references": [
    { "path": "packages/core" },
    { "path": "packages/github-adapter" },
    { "path": "packages/storage-memory" }
  ]
}
